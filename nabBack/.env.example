# Environment (development or production)
NODE_ENV=development

# Development MongoDB (localhost or MongoDB Atlas for dev)
MONGODB_URI=your_development_mongodb_uri
DB_NAME=basicWebDataBase

# Production MongoDB (Dokploy/Docker MongoDB)
MONGODB_URI_PROD=your_production_mongodb_uri
DB_NAME_PROD=basicWebDataBase

# Admin Dashboard Authentication
# IMPORTANT: Change these to secure values in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password

# Admin Server Configuration (separate port for security)
# Port for admin server (default: 4000)
ADMIN_PORT=4000
# Host binding (127.0.0.1 = localhost only, 0.0.0.0 = all interfaces)
# IMPORTANT: Use 127.0.0.1 in production for security!
ADMIN_HOST=127.0.0.1
