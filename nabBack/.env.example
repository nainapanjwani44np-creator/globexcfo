# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Environment (development or production)
NODE_ENV=development

# Development MongoDB (localhost or MongoDB Atlas for dev)
MONGODB_URI=your_development_mongodb_uri_here
DB_NAME=your_database_name

# Production MongoDB (set this in Dokploy environment variables!)
MONGODB_URI_PROD=your_production_mongodb_uri_here
DB_NAME_PROD=your_production_database_name

# Server Configuration
PORT=3000
HOST=0.0.0.0
